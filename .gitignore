# ============================================================
# Terraform
# ============================================================

# Local Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
tfplan
*.tfplan
destroy.tfplan

# Local state backups created manually
terraform-state-before-destroy.json
terraform-state-backup.json
*-state-backup.json

# Terraform CLI configuration
.terraformrc
terraform.rc


# ============================================================
# Terraform Variable Files / Secrets
# ============================================================

# Variable files may contain secrets or environment-specific values
*.tfvars
*.tfvars.json

# Allow a safe example variable file to be committed
!*.tfvars.example


# ============================================================
# Terraform Override Files
# ============================================================

override.tf
override.tf.json
*_override.tf
*_override.tf.json


# ============================================================
# Environment / Secret Files
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key
*.pfx
*.p12


# ============================================================
# Azure / Local Authentication Files
# ============================================================

.azure/
azureProfile.json


# ============================================================
# IDE / Editor Files
# ============================================================

.vscode/
.idea/

*.swp
*.swo
*.tmp


# ============================================================
# Operating System Files
# ============================================================

.DS_Store
Thumbs.db
desktop.ini


# ============================================================
# Logs
# ============================================================

*.log
logs/


# ============================================================
# Temporary / Backup Files
# ============================================================

*.bak
*.backup
*.old
*~